<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Validador de Tarjetas - Servidor Educativo SARE 1523</title>
    <!-- Google Fonts & Tailwind CSS -->
    <link href="https://fonts.googleapis.com/css2?family=Public+Sans:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    <script src="https://cdn.tailwindcss.com"></script>
    <style>
        body { font-family: 'Public Sans', sans-serif; background-color: #f8fafc; }
        .bg-gob-primary { background-color: #691C32; } /* Guinda institucional */
        .text-gob-primary { color: #691C32; }
        .border-gob-primary { border-color: #691C32; }
        .btn-gob { background-color: #5b1328; transition: background-color 0.2s; }
        .btn-gob:hover { background-color: #440e1e; }
    </style>
</head>
<body class="min-h-screen flex flex-col justify-between">

    <!-- Header Institucional -->
    <header class="bg-gob-primary text-white shadow-md">
        <div class="max-w-4xl mx-auto px-4 py-3 flex justify-between items-center">
            <div class="flex items-center space-x-4">
                <div class="bg-white text-gob-primary font-bold px-3 py-2 text-xs rounded shadow">
                    GOBIERNO DE MÉXICO
                </div>
                <div>
                    <h1 class="text-lg font-semibold leading-tight">Servidor Educativo - SARE 1523</h1>
                    <p class="text-xs text-red-200">Versión 1.9 (Validador de Tarjetas)</p>
                </div>
            </div>
            <button onclick="cerrarSesion()" class="bg-amber-500 hover:bg-amber-600 text-white font-medium text-xs px-4 py-2 rounded shadow">
                Salir
            </button>
        </div>
    </header>

    <!-- Contenido Principal -->
    <main class="max-w-4xl w-full mx-auto p-4 flex-grow space-y-6">

        <!-- Tarjeta de Consulta -->
        <div class="bg-white rounded-xl shadow-md p-6 border-t-4 border-gob-primary">
            <h2 class="text-lg font-semibold text-gray-800 mb-1">Consulta por CURP</h2>
            <p class="text-xs text-gray-500 mb-4">Escriba, pegue, escanee o dicte el CURP:</p>

            <div class="space-y-4">
                <div class="flex flex-col sm:flex-row gap-3">
                    <input type="text" id="curpInput" placeholder="Ej. AAHG941009MMCLRR04" 
                        class="flex-grow uppercase tracking-wider font-mono border border-gray-300 rounded-lg px-4 py-3 text-gray-700 focus:outline-none focus:ring-2 focus:ring-[#691C32]">
                    <div class="flex gap-2">
                        <button onclick="limpiarFormulario()" class="bg-slate-200 hover:bg-slate-300 text-slate-700 font-medium px-4 py-3 rounded-lg text-sm transition">
                            Limpiar
                        </button>
                        <button onclick="consultarCurp()" class="btn-gob text-white font-medium px-6 py-3 rounded-lg text-sm shadow">
                            Buscar
                        </button>
                    </div>
                </div>

                <button onclick="escanearCamara()" class="w-full bg-[#b2571c] hover:bg-[#9a4b17] text-white font-medium py-3 px-4 rounded-lg flex items-center justify-center space-x-2 shadow transition">
                    <span>📷 Escanear con Cámara</span>
                </button>
            </div>
        </div>

        <!-- Consola de Depuración -->
        <div class="bg-slate-900 text-emerald-400 font-mono text-xs rounded-xl p-4 shadow-inner overflow-x-auto">
            <p class="text-slate-400 mb-1">🔍 Consola de Depuración:</p>
            <div id="consoleOutput">Esperando consulta de CURP...</div>
        </div>

        <!-- Resultado / Información del Beneficiario -->
        <div id="resultadoCard" class="bg-white rounded-xl shadow-md p-6 border-l-8 border-amber-500 hidden relative">
            <h3 class="text-xs font-bold tracking-wider text-gray-400 uppercase mb-4">Información del Beneficiario</h3>
            
            <div id="resultadoContent" class="space-y-3 text-sm text-gray-700">
                <!-- Se llena dinámicamente -->
            </div>

            <div class="mt-6 pt-4 border-t border-gray-100 flex justify-end">
                <button onclick="limpiarFormulario()" class="btn-gob text-white text-xs font-semibold px-5 py-2.5 rounded-lg shadow">
                    Consultar nuevo CURP
                </button>
            </div>
        </div>

    </main>

    <!-- Footer -->
    <footer class="bg-slate-100 border-t border-slate-200 py-4 text-center text-xs text-slate-500">
        Coordinación Nacional de Becas para el Bienestar • Región 1523 (SARE Tultitlán)
    </footer>

    <!-- Script de Conexión -->
    <script>
        // PEGA AQUÍ LA URL DE TU APLICACIÓN WEB DE GOOGLE APPS SCRIPT (Termina en /exec)
        const API_URL = "TU_URL_DE_APPS_SCRIPT_AQUI";

        async function consultarCurp() {
            const curp = document.getElementById('curpInput').value.trim().toUpperCase();
            const consoleOut = document.getElementById('consoleOutput');
            const resultadoCard = document.getElementById('resultadoCard');
            const resultadoContent = document.getElementById('resultadoContent');

            if (!curp) {
                alert("Por favor, ingrese un CURP válido.");
                return;
            }

            consoleOut.innerText = `Enviando consulta para CURP: ${curp}...`;
            resultadoCard.classList.add('hidden');

            if (API_URL.includes("https://script.google.com/macros/s/AKfycbysXUtieAzJfOTJhK2pbUCRfexdhO4fVLNianLC5DZADl3jrB1N3Y7LYhxhUXvAHYsu/exec")) {
                consoleOut.innerText = `Error: Debe configurar la variable API_URL con su enlace de Google Apps Script.`;
                return;
            }

            try {
                const response = await fetch(`${API_URL}?curp=${encodeURIComponent(curp)}`);
                const data = await response.json();

                consoleOut.innerText = `Respuesta recibida:\n${JSON.stringify(data, null, 2)}`;

                resultadoCard.classList.remove('hidden');

                if (data.encontrado) {
                    resultadoCard.classList.remove('border-red-500');
                    resultadoCard.classList.add('border-emerald-500');
                    
                    resultadoContent.innerHTML = `
                        <p><strong>CURP:</strong> ${data.curp}</p>
                        <p><strong>PROGRAMA:</strong> ${data.programa}</p>
                        <p><strong>CUPO CAPTURISTA:</strong> ${data.capturista}</p>
                        <p><strong>RESULTADO VERIFICACIÓN:</strong> <span class="bg-red-100 text-red-800 font-bold px-2 py-0.5 rounded">${data.verificacion}</span></p>
                        <p class="text-base mt-2"><strong>SOLUCIÓN / DICTAMEN:</strong> <span class="bg-emerald-100 text-emerald-800 font-extrabold px-2 py-1 rounded">${data.solucion}</span></p>
                    `;
                } else {
                    resultadoCard.classList.remove('border-emerald-500');
                    resultadoCard.classList.add('border-red-500');

                    resultadoContent.innerHTML = `
                        <div class="bg-red-50 border border-red-200 p-4 rounded-lg text-red-700">
                            <p class="font-bold text-base mb-1">❌ No se encuentra en el listado</p>
                            <p>${data.mensaje || "Favor de revisar sistemas para encontrar problema particular."}</p>
                        </div>
                    `;
                }

            } catch (error) {
                consoleOut.innerText = `Error de conexión con el servidor: ${error.message}`;
                resultadoCard.classList.remove('hidden');
                resultadoContent.innerHTML = `<p class="text-red-600 font-bold">Error al conectar con la base de datos de Google Sheets. Verifique la URL de Apps Script.</p>`;
            }
        }

        function limpiarFormulario() {
            document.getElementById('curpInput').value = '';
            document.getElementById('consoleOutput').innerText = 'Consola limpia. Esperando consulta...';
            document.getElementById('resultadoCard').classList.add('hidden');
            document.getElementById('curpInput').focus();
        }

        function escanearCamara() {
            alert("Módulo de cámara simulado. (Puede integrar una librería QR/Barcode o usar la entrada de texto por voz/escáner móvil).");
        }

        function cerrarSesion() {
            if(confirm("¿Desea salir del sistema?")) {
                window.location.reload();
            }
        }
    </script>
</body>
</html>
